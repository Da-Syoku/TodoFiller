<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:background="@color/surface"
    android:padding="14dp">

    <View
        android:id="@+id/materialBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:minHeight="56dp"
        android:background="@color/accent_goal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/materialName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/on_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 進み具合: "2周目 34/107問 ・ 実測 5.6分/問" -->
        <TextView
            android:id="@+id/materialProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/on_bg_dim"
            android:textSize="12sp" />

        <!-- 「間に合う/間に合わない」。この行が全体で一番大事。 -->
        <TextView
            android:id="@+id/materialVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 自動で削った内容。黙って消さないために出す。 -->
        <TextView
            android:id="@+id/materialTrimmed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/on_bg_dim"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/materialRemain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text=""
            android:textColor="@color/accent_goal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/recordButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="記録"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/editMaterialButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="編集"
                android:textColor="@color/on_bg_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
