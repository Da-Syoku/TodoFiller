<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 端末内アラームでアプリを閉じていても通知する。Play非配布なのでUSE_EXACT_ALARMで自動許可。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- オンライン更新：ダウンロードしたAPKをインストールするために必要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ドパチル(com.dopachiru)へ学習予定を渡すための署名レベル権限。
         同じ鍵で署名されたアプリしか名乗れない。ドパチル未導入なら単に付与されないだけ。 -->
    <uses-permission android:name="com.dopachiru.permission.SYNC_STUDY" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dynasched">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".AddTaskActivity"
            android:exported="false"
            android:label="タスクを追加" />

        <!-- Googleログイン完了後のディープリンク dynasched://auth を受け取る -->
        <activity
            android:name=".AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dynasched" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- 更新APKを他アプリ（インストーラ）に安全に渡すためのFileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- アラーム発火時に通知を出すレシーバ -->
        <receiver
            android:name=".notify.AlarmReceiver"
            android:exported="false" />

        <!-- 再起動後にアラームを再登録するレシーバ -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- フィードバック通知のアクションボタン（完了/進捗）を処理するレシーバ -->
        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:exported="false" />

        <!-- ホーム画面ウィジェット：空き時間のタスク提案 -->
        <receiver
            android:name=".widget.SuggestWidgetProvider"
            android:exported="true"
            android:label="タスク提案">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_suggest_info" />
        </receiver>

    </application>
</manifest>
