<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="いまできること（家）"
            android:textColor="@color/on_bg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- タスクを足す。思いついた時にアプリを開かずに済ませるための入口 -->
        <TextView
            android:id="@+id/widgetAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/widgetFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暇"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="4dp" />

        <TextView
            android:id="@+id/widgetLocToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家⇔外"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:padding="4dp" />

        <TextView
            android:id="@+id/widgetRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetLine1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/widgetLine2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widgetLine3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widgetLine4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widgetLine5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widgetLine6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_bg_dim"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="6dp" />
</LinearLayout>
